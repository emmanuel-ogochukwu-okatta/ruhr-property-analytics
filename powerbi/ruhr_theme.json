{
  "name": "Ruhr Property Analytics",
  "dataColors": ["#2A78D6", "#EB6834", "#1BAF7A", "#EDA100", "#E87BA4", "#008300", "#4A3AA7", "#E34948"],
  "background": "#FFFFFF",
  "foreground": "#0B0B0B",
  "tableAccent": "#2A78D6",
  "good": "#1BAF7A",
  "neutral": "#EDA100",
  "bad": "#E34948",
  "maximum": "#2A78D6",
  "center": "#A9C7EF",
  "minimum": "#EAF2FC",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#0B0B0B" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#0B0B0B" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52514E" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#0B0B0B" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E6E5E1" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F4F2" } }, "transparency": 0 }]
      }
    }
  }
}
